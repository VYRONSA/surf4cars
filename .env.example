# SURF FOR CARS — Environment Variables
#
# Nothing in this file is a working value. Every secret is supplied per environment; none has a
# default in code, because a credential that works from anywhere is one nobody notices until it is
# rotated.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3003

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# ─── Dealer enquiry notifications ──────────────────────────────────────────────────────────────
#
# With none of these set, the platform still records every enquiry and every dealership can still
# see its own in the dealer dashboard. What it cannot do is tell anyone an enquiry arrived, and the
# buyer's confirmation says exactly that rather than claiming otherwise. Enquiries received while
# unconfigured are held and sent on the first sweep after a provider is set — they are not stranded.
#
# resend | sendgrid | ses | mock
#   ses is not implemented in this build and is refused at configuration time.
#   mock simulates sends for testing and is refused when NODE_ENV=production.
EMAIL_PROVIDER=

# The provider's API key. One variable rather than RESEND_API_KEY and SENDGRID_API_KEY, so changing
# provider is one edit and there is never a second half-configured provider that could win silently.
EMAIL_API_KEY=

# The sender, e.g. "SURF4CARS <enquiries@surf4cars.co.za>". The domain must be verified with the
# provider, or messages are accepted and then silently dropped.
EMAIL_FROM=

# Shared secret for POST /api/v1/internal/notifications/retry, which drains the retry queue.
# Unset means the endpoint refuses every request — so a notification that fails its first attempt is
# never retried. Set this and point a scheduler at the endpoint every five minutes.
NOTIFICATION_CRON_SECRET=

# Optional. Caps delivery attempts per enquiry; defaults to 4 (immediate, +5 min, +30 min, +2 h).
# Clamped to 4 — the retry schedule has no delay defined beyond that, and an attempt with no delay
# would fire on every sweep.
NOTIFICATION_MAX_ATTEMPTS=
